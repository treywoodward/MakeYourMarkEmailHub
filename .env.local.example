# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.

# --- Database: Neon Postgres (free) ---
# Create a free project at https://neon.tech (or add Neon from the Vercel
# Marketplace). Copy the connection string (it looks like the line below).
# Then run: npm run db:push   to create the tables.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Auth: Clerk (free) ---
# In dev, Clerk can run "keyless" and generate these for you automatically.
# To set them manually, get them from https://dashboard.clerk.com > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated emails that should be admins (Trey). Everyone else is a client.
ADMIN_EMAILS=trey.woodward@gmail.com

# --- Anthropic (Phase 2: copy generation, vision) ---
ANTHROPIC_API_KEY=

# --- GoHighLevel (Phase 0 spike, Phase 4 push) ---
# Private Integration token on Dusty's sub-account.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# --- Market data (Phase 5) ---
# FRED API key for the Freddie Mac 30-yr mortgage rate (series MORTGAGE30US).
FRED_API_KEY=

# --- Web Push / VAPID (Phase 4) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dusty@makeyourmarklbk.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
