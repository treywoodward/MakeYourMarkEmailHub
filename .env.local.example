# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.

# --- Supabase (Phase 1) ---
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, bypasses RLS. Used by cron jobs / admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Phase 2: copy generation, vision) ---
ANTHROPIC_API_KEY=

# --- GoHighLevel (Phase 0 spike, Phase 4 push) ---
# Private Integration token on Dusty's sub-account.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# --- Market data (Phase 5) ---
# FRED API key for the Freddie Mac 30-yr mortgage rate (series MORTGAGE30US).
FRED_API_KEY=

# --- Web Push / VAPID (Phase 4) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dusty@makeyourmarklbk.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
